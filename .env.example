# Admin login (required)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password
AUTH_SECRET=replace-with-long-random-string-openssl-rand-hex-32

# Public site URL (required in production — your Netlify URL or custom domain)
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Firebase (optional but required for permanent data on Netlify)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
PAYMENT_TEST_MODE=false

# --- Production safety switches (leave UNSET unless you know why) ---
# SEED_DEMO=true                       # create demo products/fake sales on a NEW production database (never for a real store)
# ALLOW_PAYMENT_TEST_IN_PRODUCTION=true  # lets the fake payment page work in production: ANYONE can mark orders paid
# ALLOW_EPHEMERAL_STORAGE=true         # allow throw-away /tmp storage on Netlify/Vercel (data is LOST on cold start)
